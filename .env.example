# Copia este archivo a .env y ajusta si tu API corre en otro host/puerto.
# El browser ya NO le pega directo a la API (PUBLIC_API_URL quedó en desuso
# para eso) -- todo pasa por el proxy propio /api/*, que agrega la auth
# interna del lado del servidor. Deja PUBLIC_API_URL sin definir.

# Dónde vive nutricion_api desde el SERVIDOR (no expuesto al browser).
API_ORIGIN=http://localhost:8000

# Debe ser IDÉNTICO al INTERNAL_TOKEN de nutricion_api/.env.
# Genéralo con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TOKEN=

# Firma las cookies de sesión (HMAC). Cambiarlo cierra la sesión de todos.
SESSION_SECRET=

# --- Solo en producción (build con adapter-node, no aplica a `npm run dev`) ---
# ORIGIN=https://kcal.moibe.me
# PORT=3600
# HOST=127.0.0.1
# API_ORIGIN=http://127.0.0.1:8002
